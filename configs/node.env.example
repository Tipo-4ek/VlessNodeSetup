# Copy to a local file outside this repository, then pass it to install.sh.
# Keep it readable only by the operator (chmod 600).
VNS_BOT_TOKEN=REPLACE_WITH_NEW_BOT_TOKEN
VNS_ADMIN_IDS=REPLACE_WITH_YOUR_TELEGRAM_ID
VNS_PUBLIC_HOST=node.example.com
VNS_REALITY_SNI=www.microsoft.com
VNS_REALITY_PORT=8443
VNS_SUBSCRIPTION_PORT=8787
# Optional. Leave empty to use the generated location.
VNS_XRAY_CONFIG=/etc/vless-node-setup/xray.json
VNS_STATE=/var/lib/vless-node-setup/users.json
