# Replace placeholders with values issued for one user. Do not share this file.
mixed-port: 7890
mode: rule
log-level: warning

proxies:
  - name: private-node
    type: vless
    server: node.example.com
    port: 8443
    uuid: REPLACE_WITH_USER_UUID
    network: tcp
    tls: true
    udp: true
    servername: REPLACE_WITH_REALITY_SNI
    client-fingerprint: chrome
    reality-opts:
      public-key: REPLACE_WITH_REALITY_PUBLIC_KEY
      short-id: REPLACE_WITH_REALITY_SHORT_ID
    flow: xtls-rprx-vision

proxy-groups:
  - name: PROXY
    type: select
    proxies: [private-node]

rules:
  - DOMAIN-SUFFIX,youtube.com,PROXY
  - DOMAIN-SUFFIX,youtu.be,PROXY
  - DOMAIN-SUFFIX,googlevideo.com,PROXY
  - DOMAIN-SUFFIX,ytimg.com,PROXY
  - DOMAIN-SUFFIX,ru,DIRECT
  - GEOIP,RU,DIRECT
  - MATCH,DIRECT
