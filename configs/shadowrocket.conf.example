# A small, generic rule set. Select your own node in Shadowrocket first.
# Update this file in Config to fetch future rule changes.
[Rule]
DOMAIN-SUFFIX,youtube.com,PROXY
DOMAIN-SUFFIX,youtu.be,PROXY
DOMAIN-SUFFIX,googlevideo.com,PROXY
DOMAIN-SUFFIX,ytimg.com,PROXY
DOMAIN-SUFFIX,ru,DIRECT
GEOIP,RU,DIRECT
FINAL,DIRECT
